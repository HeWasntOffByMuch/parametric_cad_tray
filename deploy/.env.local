# The local rehearsal: the whole production stack, minus TLS, on ports that do
# not need root.  Used by `make deploy-local`.
TRAYMOLD_IMAGE=traymold-api:local

# A bare port rather than a hostname, so Caddy serves plain HTTP and never tries
# to get a certificate for something that does not resolve.
TRAYMOLD_SITE_ADDRESS=:80
# Never used: ACME does not run for a bare-port site address. Caddy just
# insists the option have a value.
TRAYMOLD_TLS_EMAIL=nobody@example.invalid
TRAYMOLD_HTTP_PORT=8080
TRAYMOLD_HTTPS_PORT=8443
TRAYMOLD_API_PORT=8000

# `vite preview` serves on 4173, `vite dev` on 5173. Both are listed so you can
# rehearse against either a production build or the dev server.
TRAYAPI_ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:5173,http://127.0.0.1:5173

TRAYAPI_WORKERS=2
