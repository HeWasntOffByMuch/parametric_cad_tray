# Copy to .env on the VPS.  The deploy workflow writes this file from GitHub
# secrets and variables, so on a CI-managed host you edit it there, not here.

# --- what to run ------------------------------------------------------------
TRAYMOLD_IMAGE=ghcr.io/hewasntoffbymuch/parametric_cad_tray/api:latest

# --- how it is reached ------------------------------------------------------
# The hostname whose DNS A/AAAA record points at this VPS. Caddy gets a
# certificate for exactly this name, so it must resolve before the stack starts.
TRAYMOLD_SITE_ADDRESS=api.example.com
# Let's Encrypt expiry notices. Required: Caddy will not start without it.
TRAYMOLD_TLS_EMAIL=you@example.com

# --- who may call it --------------------------------------------------------
# The browser app runs on GitHub Pages, a different origin, so this list is the
# only thing standing between the API and every page on the internet. Comma
# separated, scheme and host, no trailing slash, no wildcard.
TRAYAPI_ALLOWED_ORIGINS=https://hewasntoffbymuch.github.io

# --- capacity ---------------------------------------------------------------
# CAD subprocesses inside the one API process. Roughly one per spare core; each
# holds an OCC session and peaks around 500 MB during a boolean.
TRAYAPI_WORKERS=2
TRAYMOLD_MEMORY_LIMIT=3g
# Per-client, sliding window, on the endpoints that cost CPU.
TRAYAPI_RATE_LIMIT_REQUESTS=20
TRAYAPI_RATE_LIMIT_WINDOW_S=60
TRAYAPI_MAX_CONCURRENT_JOBS_PER_CLIENT=3
# Artifacts are content-addressed and swept on both size and age.
TRAYAPI_CACHE_MAX_BYTES=2147483648
TRAYAPI_CACHE_MAX_AGE_S=604800
