# Copy to .env on the VPS.  The deploy workflow writes this file from GitHub
# secrets and variables, so on a CI-managed host you edit it there, not here.

# --- what to run ------------------------------------------------------------
TRAYMOLD_IMAGE=ghcr.io/hewasntoffbymuch/parametric_cad_tray/api:latest

# --- how it is reached ------------------------------------------------------
# Where the API listens on the host. Loopback is right whenever a proxy on this
# same host forwards to it, which is both supported modes.
TRAYMOLD_API_BIND=127.0.0.1:8000

# MODE 1 - the bundled Caddy owns 80 and 443 and gets its own certificate.
#   docker compose --env-file .env --profile caddy up -d
# The hostname whose DNS A/AAAA record points at this VPS. Caddy gets a
# certificate for exactly this name, so it must resolve before the stack starts.
TRAYMOLD_SITE_ADDRESS=api.example.com
# Let's Encrypt expiry notices. Caddy will not start without a value.
TRAYMOLD_TLS_EMAIL=you@example.com

# MODE 2 - something else on this host already owns 80/443.
#   docker compose --env-file .env up -d
# Drop the --profile flag, ignore the two settings above, and point your existing
# nginx / Caddy / Traefik at TRAYMOLD_API_BIND. The SSE route needs explicit
# un-buffering there; see "Behind a proxy you already run" in docs/deployment.md.

# --- who may call it --------------------------------------------------------
# The browser app runs on GitHub Pages, a different origin, so this list is the
# only thing standing between the API and every page on the internet. Comma
# separated, scheme and host, no trailing slash, no wildcard.
TRAYAPI_ALLOWED_ORIGINS=https://hewasntoffbymuch.github.io

# --- capacity ---------------------------------------------------------------
# CAD subprocesses inside the one API process. Roughly one per spare core; each
# holds an OCC session and peaks around 500 MB during a boolean.
TRAYAPI_WORKERS=2
TRAYMOLD_MEMORY_LIMIT=3g
# Per-client, sliding window, on the endpoints that cost CPU.
TRAYAPI_RATE_LIMIT_REQUESTS=20
TRAYAPI_RATE_LIMIT_WINDOW_S=60
TRAYAPI_MAX_CONCURRENT_JOBS_PER_CLIENT=3
# Artifacts are content-addressed and swept on both size and age.
TRAYAPI_CACHE_MAX_BYTES=2147483648
TRAYAPI_CACHE_MAX_AGE_S=604800

# --- usage analytics --------------------------------------------------------
# A SQLite file in its own docker volume, counting how many custom molds were
# generated and downloaded. Leave this line out to keep that default; set it to
# an empty value to turn analytics off entirely; set a path to move the file.
# It must not live under TRAYAPI_CACHE_DIR - that directory is swept.
#   docker compose exec api python -m trayapi.analytics.report   summary
#   docker run --rm -v traymold_analytics:/d alpine \
#     cp /d/analytics.sqlite3 /d/backup.sqlite3                  backup
TRAYMOLD_ANALYTICS_DB=/var/lib/traymold/analytics/analytics.sqlite3
