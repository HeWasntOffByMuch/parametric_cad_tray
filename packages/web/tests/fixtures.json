     "additionalProperties": false,
     "properties": {
      "profile": {
       "discriminator": {
        "mapping": {
         "circular_obround": "#/$defs/CircularObroundProfile",
         "circular_rect": "#/$defs/CircularRectProfile",
         "conic_obround": "#/$defs/ConicObroundProfile",
         "conic_rect": "#/$defs/ConicRectProfile",
         "ellipse": "#/$defs/EllipseProfile",
