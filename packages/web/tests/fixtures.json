       "discriminator": {
        "mapping": {
         "chamfer": "#/$defs/ChamferTreatment",
         "circular_fillet": "#/$defs/CircularFillet",
         "g2_quintic_blend": "#/$defs/G2QuinticBlend",
         "none": "#/$defs/NoTreatment"
        },
        "propertyName": "kind"
       },
       "oneOf": [
        {
         "$ref": "#/$defs/CircularFillet"
        },
        {
         "$ref": "#/$defs/G2QuinticBlend"
        },
        {
         "$ref": "#/$defs/ChamferTreatment"
        },
        {
         "$ref": "#/$defs/NoTreatment"
        }
       ],
       "title": "Female Entry Blend Bottom"
      },
      "plate_edge_chamfer": {
