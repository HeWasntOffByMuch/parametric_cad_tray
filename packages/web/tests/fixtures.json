       "title": "Kind",
       "type": "string"
      }
     },
     "title": "NoTreatment",
     "type": "object"
    },
    "PartSelection": {
     "additionalProperties": false,
     "properties": {
      "male": {
       "default": true,
       "title": "Male",
       "type": "boolean"
      },
      "female": {
       "default": true,
       "title": "Female",
       "type": "boolean"
      }
     },
     "title": "PartSelection",
     "type": "object"
