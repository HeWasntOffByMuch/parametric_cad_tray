     "additionalProperties": false,
     "properties": {
      "enabled": {
       "default": false,
       "title": "Enabled",
       "type": "boolean"
      },
      "pattern": {
       "default": "four_corners",
       "enum": [
        "diagonal_pair",
        "four_corners"
       ],
       "title": "Pattern",
       "type": "string"
      },
      "diameter": {
       "default": 6.0,
       "exclusiveMinimum": 0,
       "maximum": 30,
       "title": "Diameter",
       "type": "number"
      },
      "height": {
       "default": 8.0,
       "exclusiveMinimum": 0,
       "maximum": 100,
       "title": "Height",
       "type": "number"
      },
      "inset": {
       "default": 15.0,
       "exclusiveMinimum": 0,
       "maximum": 200,
       "title": "Inset",
       "type": "number"
      }
     },
     "title": "AlignmentPins",
     "type": "object"
    },
    "ChamferTreatment": {
     "additionalProperties": false,
     "properties": {
      "kind": {
       "const": "chamfer",
       "default": "chamfer",
       "title": "Kind",
       "type": "string"
      },
      "distance": {
       "description": "chamfer distance, mm",
       "exclusiveMinimum": 0.0,
       "maximum": 100.0,
       "title": "Distance",
       "type": "number"
      }
     },
     "required": [
      "distance"
     ],
     "title": "ChamferTreatment",
     "type": "object"
    },
    "CircularFillet": {
     "additionalProperties": false,
     "description": "Constant-radius rolling-ball fillet.  The male root treatment in the\nreference: cylindrical faces on the straight runs, exact circular sweeps at\nthe corners.",
     "properties": {
      "kind": {
       "const": "circular_fillet",
       "default": "circular_fillet",
       "title": "Kind",
       "type": "string"
      },
      "radius": {
       "description": "fillet radius, mm",
       "exclusiveMinimum": 0.0,
       "maximum": 100.0,
       "title": "Radius",
       "type": "number"
      }
     },
     "required": [
      "radius"
     ],
     "title": "CircularFillet",
     "type": "object"
    },
    "CircularObroundProfile": {
     "additionalProperties": false,
     "description": "Conventional stadium / obround: circular ends of radius width / 2.",
     "properties": {
      "length": {
       "description": "plan length, X, mm",
       "exclusiveMinimum": 0,
       "maximum": 1000,
       "title": "Length",
       "type": "number"
      },
      "width": {
       "description": "plan width, Y, mm",
       "exclusiveMinimum": 0,
       "maximum": 1000,
       "title": "Width",
       "type": "number"
      },
      "kind": {
       "const": "circular_obround",
       "default": "circular_obround",
       "title": "Kind",
       "type": "string"
      }
     },
     "required": [
      "length",
      "width"
     ],
     "title": "CircularObroundProfile",
     "type": "object"
    },
    "CircularRectProfile": {
     "additionalProperties": false,
     "description": "Conventional rounded rectangle: constant-radius circular corners.",
     "properties": {
      "length": {
       "description": "plan length, X, mm",
       "exclusiveMinimum": 0,
       "maximum": 1000,
       "title": "Length",
       "type": "number"
      },
      "width": {
       "description": "plan width, Y, mm",
       "exclusiveMinimum": 0,
       "maximum": 1000,
       "title": "Width",
       "type": "number"
      },
      "kind": {
       "const": "circular_rect",
       "default": "circular_rect",
       "title": "Kind",
       "type": "string"
      },
      "corner_radius": {
       "minimum": 0,
       "title": "Corner Radius",
       "type": "number"
      }
     },
     "required": [
      "length",
      "width",
      "corner_radius"
     ],
     "title": "CircularRectProfile",
     "type": "object"
    },
    "ClampHoles": {
     "additionalProperties": false,
     "properties": {
      "enabled": {
       "default": false,
       "title": "Enabled",
       "type": "boolean"
      },
      "pattern": {
       "default": "diagonal_pair",
       "enum": [
        "diagonal_pair",
        "four_corners"
       ],
       "title": "Pattern",
       "type": "string"
      },
      "diagonal": {
       "default": "nw_se",
       "enum": [
        "nw_se",
        "ne_sw"
       ],
       "title": "Diagonal",
       "type": "string"
      },
      "diameter": {
       "default": 6.0,
       "exclusiveMinimum": 0,
       "maximum": 30,
       "title": "Diameter",
       "type": "number"
      },
      "inset": {
       "default": 15.0,
       "exclusiveMinimum": 0,
       "maximum": 200,
       "title": "Inset",
       "type": "number"
      },
      "top_chamfer": {
       "default": 2.0,
       "maximum": 10.0,
       "minimum": 0.0,
       "title": "Top Chamfer",
       "type": "number"
      },
      "in_male": {
       "default": false,
       "title": "In Male",
       "type": "boolean"
      },
      "in_female": {
       "default": true,
       "title": "In Female",
       "type": "boolean"
      }
     },
     "title": "ClampHoles",
     "type": "object"
    },
    "ConicObroundProfile": {
     "additionalProperties": false,
     "properties": {
      "length": {
       "description": "plan length, X, mm",
       "exclusiveMinimum": 0,
       "maximum": 1000,
       "title": "Length",
       "type": "number"
      },
      "width": {
       "description": "plan width, Y, mm",
       "exclusiveMinimum": 0,
       "maximum": 1000,
       "title": "Width",
       "type": "number"
      },
      "kind": {
       "const": "conic_obround",
       "default": "conic_obround",
       "title": "Kind",
       "type": "string"
      },
      "rho": {
       "default": 0.5,
       "exclusiveMaximum": 1.0,
       "exclusiveMinimum": 0.0,
       "title": "Rho",
       "type": "number"
      }
     },
     "required": [
      "length",
      "width"
     ],
     "title": "ConicObroundProfile",
     "type": "object"
    },
    "ConicRectProfile": {
     "additionalProperties": false,
     "description": "Rectangle with rational-quadratic (conic) corners.  rho = 0.5 is the parabola.",
     "properties": {
      "length": {
       "description": "plan length, X, mm",
       "exclusiveMinimum": 0,
       "maximum": 1000,
       "title": "Length",
       "type": "number"
      },
      "width": {
       "description": "plan width, Y, mm",
       "exclusiveMinimum": 0,
       "maximum": 1000,
       "title": "Width",
       "type": "number"
      },
      "kind": {
       "const": "conic_rect",
       "default": "conic_rect",
       "title": "Kind",
       "type": "string"
      },
      "corner_setback": {
       "minimum": 0,
       "title": "Corner Setback",
       "type": "number"
      },
      "rho": {
       "default": 0.5,
       "exclusiveMaximum": 1.0,
       "exclusiveMinimum": 0.0,
       "title": "Rho",
       "type": "number"
      }
     },
     "required": [
      "length",
      "width",
      "corner_setback"
     ],
     "title": "ConicRectProfile",
     "type": "object"
    },
    "EllipseProfile": {
     "additionalProperties": false,
     "properties": {
      "length": {
       "description": "plan length, X, mm",
       "exclusiveMinimum": 0,
       "maximum": 1000,
       "title": "Length",
       "type": "number"
      },
      "width": {
       "description": "plan width, Y, mm",
       "exclusiveMinimum": 0,
       "maximum": 1000,
       "title": "Width",
       "type": "number"
      },
      "kind": {
       "const": "ellipse",
       "default": "ellipse",
       "title": "Kind",
       "type": "string"
      }
     },
     "required": [
      "length",
      "width"
     ],
     "title": "EllipseProfile",
     "type": "object"
