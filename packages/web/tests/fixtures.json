      },
      "cavity_plate_thickness": {
       "default": 25.0,
       "exclusiveMinimum": 0,
       "maximum": 300,
       "title": "Cavity Plate Thickness",
       "type": "number"
      },
      "male_root_blend": {
       "default": {
        "kind": "circular_fillet",
        "radius": 1.2
       },
       "discriminator": {
        "mapping": {
         "chamfer": "#/$defs/ChamferTreatment",
         "circular_fillet": "#/$defs/CircularFillet",
         "g2_quintic_blend": "#/$defs/G2QuinticBlend",
         "none": "#/$defs/NoTreatment"
        },
        "propertyName": "kind"
       },
       "oneOf": [
        {
         "$ref": "#/$defs/CircularFillet"
        },
        {
         "$ref": "#/$defs/G2QuinticBlend"
        },
        {
         "$ref": "#/$defs/ChamferTreatment"
        },
        {
         "$ref": "#/$defs/NoTreatment"
        }
       ],
       "title": "Male Root Blend"
      },
      "male_floor_blend": {
       "default": {
        "kind": "g2_quintic_blend",
        "setback": 5.0
       },
       "discriminator": {
        "mapping": {
         "chamfer": "#/$defs/ChamferTreatment",
         "circular_fillet": "#/$defs/CircularFillet",
         "g2_quintic_blend": "#/$defs/G2QuinticBlend",
         "none": "#/$defs/NoTreatment"
        },
        "propertyName": "kind"
       },
       "oneOf": [
        {
         "$ref": "#/$defs/CircularFillet"
        },
        {
         "$ref": "#/$defs/G2QuinticBlend"
        },
        {
         "$ref": "#/$defs/ChamferTreatment"
        },
        {
         "$ref": "#/$defs/NoTreatment"
        }
       ],
       "title": "Male Floor Blend"
      },
      "female_entry_blend_top": {
       "default": {
        "kind": "g2_quintic_blend",
        "setback": 3.0
       },
       "discriminator": {
        "mapping": {
         "chamfer": "#/$defs/ChamferTreatment",
         "circular_fillet": "#/$defs/CircularFillet",
         "g2_quintic_blend": "#/$defs/G2QuinticBlend",
         "none": "#/$defs/NoTreatment"
        },
        "propertyName": "kind"
       },
       "oneOf": [
        {
         "$ref": "#/$defs/CircularFillet"
        },
        {
         "$ref": "#/$defs/G2QuinticBlend"
        },
        {
         "$ref": "#/$defs/ChamferTreatment"
        },
        {
         "$ref": "#/$defs/NoTreatment"
        }
       ],
       "title": "Female Entry Blend Top"
