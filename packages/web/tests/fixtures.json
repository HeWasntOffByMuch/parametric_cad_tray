    "QualityParams": {
     "additionalProperties": false,
     "description": "Preview and export describe the same geometry; they differ only in loft\nsection density and tessellation tolerance.  Leave the overrides at None to\ntake the mode's measured defaults from `traymold.quality.DEFAULTS`.",
     "properties": {
      "mode": {
       "default": "export",
       "enum": [
        "preview",
        "export"
       ],
       "title": "Mode",
       "type": "string"
      },
      "blend_sections": {
       "anyOf": [
        {
         "maximum": 256,
         "minimum": 4,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "cap on loft sections per edge treatment",
       "title": "Blend Sections"
      },
      "max_section_sagitta": {
       "anyOf": [
        {
         "exclusiveMinimum": 0,
         "maximum": 1.0,
         "type": "number"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "target loft chord error, mm",
       "title": "Max Section Sagitta"
      },
      "linear_deflection": {
       "anyOf": [
        {
         "exclusiveMinimum": 0,
         "maximum": 5.0,
         "type": "number"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Linear Deflection"
      },
      "angular_deflection": {
       "anyOf": [
        {
         "exclusiveMinimum": 0,
         "maximum": 1.5,
         "type": "number"
