    "Features": {
     "additionalProperties": false,
     "properties": {
      "clamp_holes": {
       "$ref": "#/$defs/ClampHoles",
       "default": {
        "enabled": false,
        "pattern": "diagonal_pair",
        "diagonal": "nw_se",
        "diameter": 6.0,
        "inset": 15.0,
        "top_chamfer": 2.0,
        "in_male": false,
        "in_female": true
       }
      },
      "pry_notches": {
       "$ref": "#/$defs/PryNotches",
       "default": {
        "enabled": false,
        "pattern": "diagonal_pair",
        "diagonal": "ne_sw",
        "size_x": 15.0,
        "size_y": 15.0,
        "depth": 8.0
       }
      },
      "alignment_pins": {
       "$ref": "#/$defs/AlignmentPins",
       "default": {
        "enabled": false,
        "pattern": "four_corners",
        "diameter": 6.0,
        "height": 8.0,
        "inset": 15.0
       }
      }
     },
     "title": "Features",
     "type": "object"
    },
    "FitParams": {
     "additionalProperties": false,
     "properties": {
      "clearance": {
       "default": 0.0,
       "maximum": 2.0,
       "minimum": -0.5,
       "title": "Clearance",
       "type": "number"
      },
      "gap_override": {
       "anyOf": [
        {
         "exclusiveMinimum": 0.0,
         "maximum": 12.0,
         "type": "number"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Gap Override"
      }
     },
     "title": "FitParams",
     "type": "object"
    },
    "G2QuinticBlend": {
     "additionalProperties": false,
     "description": "The reference's curvature-continuous blend, given by its setback.",
     "properties": {
      "kind": {
       "const": "g2_quintic_blend",
       "default": "g2_quintic_blend",
       "title": "Kind",
       "type": "string"
      },
      "setback": {
       "description": "setback from the sharp edge, mm",
       "exclusiveMinimum": 0.0,
       "maximum": 100.0,
       "title": "Setback",
       "type": "number"
      }
     },
     "required": [
      "setback"
     ],
     "title": "G2QuinticBlend",
     "type": "object"
    },
    "G2QuinticObroundProfile": {
     "additionalProperties": false,
     "description": "The reference profile: G2 quintic corners at the maximum setback, so the\nshort ends have no straight run at all.",
     "properties": {
      "length": {
       "description": "plan length, X, mm",
       "exclusiveMinimum": 0,
       "maximum": 1000,
       "title": "Length",
       "type": "number"
      },
      "width": {
       "description": "plan width, Y, mm",
       "exclusiveMinimum": 0,
       "maximum": 1000,
       "title": "Width",
       "type": "number"
      },
      "kind": {
       "const": "g2_quintic_obround",
       "default": "g2_quintic_obround",
       "title": "Kind",
       "type": "string"
      }
     },
     "required": [
      "length",
      "width"
     ],
     "title": "G2QuinticObroundProfile",
     "type": "object"
    },
    "G2QuinticRectProfile": {
     "additionalProperties": false,
     "description": "Rectangle with the reference's G2 corner: non-rational quintic B-spline,\nzero curvature at both tangent points.  Recovered verbatim from the Onshape\nSTEP; not a conic and not approximable by one within 0.23 mm at s = 52.5.",
     "properties": {
      "length": {
       "description": "plan length, X, mm",
       "exclusiveMinimum": 0,
       "maximum": 1000,
       "title": "Length",
       "type": "number"
      },
      "width": {
       "description": "plan width, Y, mm",
       "exclusiveMinimum": 0,
       "maximum": 1000,
       "title": "Width",
       "type": "number"
      },
      "kind": {
       "const": "g2_quintic_rect",
       "default": "g2_quintic_rect",
       "title": "Kind",
       "type": "string"
      },
      "corner_setback": {
       "description": "setback from the sharp corner, mm",
       "minimum": 0,
       "title": "Corner Setback",
       "type": "number"
      }
     },
     "required": [
      "length",
      "width",
      "corner_setback"
     ],
     "title": "G2QuinticRectProfile",
     "type": "object"
    },
    "LeatherParams": {
     "additionalProperties": false,
     "properties": {
      "thickness": {
