       "exclusiveMinimum": 0,
       "maximum": 1000,
       "title": "Length",
       "type": "number"
      },
      "width": {
       "description": "plan width, Y, mm",
       "exclusiveMinimum": 0,
       "maximum": 1000,
       "title": "Width",
       "type": "number"
      },
      "kind": {
       "const": "superellipse",
       "default": "superellipse",
       "title": "Kind",
       "type": "string"
